# =====================================================================
# MOSTWIN88 RENDER PRIVATE BACKEND ENVIRONMENT VARIABLES
# =====================================================================
# IMPORTANT: NEVER commit real `.env` or `serviceAccountKey.json` to GitHub!
# Set these variables inside Render Dashboard -> Environment -> Env Vars / Secret Files.

# Server port (Render sets this automatically)
PORT=3000
NODE_ENV=production

# Primary Master Administrator Email (checked server-side on every Master API call)
MASTER_ADMIN_EMAIL=mijanbabu2015@gmail.com

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://mostwin88-febbf-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Admin SDK Credential (Option A: paste whole JSON string or base64 JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mostwin88-febbf",...}

# Firebase Admin SDK Credential (Option B: Render Secret File path)
# Upload `serviceAccountKey.json` in Render -> Environment -> Secret Files:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json

# Optional: Allowed frontend CORS origins (comma-separated, e.g. https://mostwin88-bakend.onrender.com,https://nexqiro.github.io)
# Leave empty or * to allow configured frontend hosts
ALLOWED_ORIGINS=*

# Optional: Internal server secret for HMAC signing & game callbacks (Render can auto-generate)
BACKEND_API_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET
